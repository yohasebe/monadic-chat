# Stage 1: Build environment

FROM ruby:3.4.7-slim-bookworm AS build
ARG PROJECT_TAG="monadic-chat"
LABEL project=$PROJECT_TAG

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential wget curl git pandoc \
    # fiddle (shared-folder writes through openat) is built against libffi;
    # the runtime stage already has libffi8 from the base image
    libffi-dev \
    ca-certificates gnupg lsb-release \
    postgresql postgresql-contrib libpq-dev \
    # RSyntaxTree (Syntax Tree) draws with Pango and librsvg through
    # GObject introspection; its gems are built against these headers
    pkg-config libglib2.0-dev libgirepository1.0-dev libcairo2-dev \
    libpango1.0-dev libgdk-pixbuf-2.0-dev librsvg2-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# RSyntaxTree is run as a command, outside the app's bundle (the bundle is
# also used on the host, where these libraries are not needed): a bundle of
# its own, in its own place, with every gem at the version and checksum of
# rsyntaxtree/Gemfile.lock (a gem that differs stops the build)
ENV RSYNTAXTREE_HOME=/opt/rsyntaxtree
COPY rsyntaxtree/Gemfile rsyntaxtree/Gemfile.lock $RSYNTAXTREE_HOME/
RUN BUNDLE_GEMFILE=$RSYNTAXTREE_HOME/Gemfile BUNDLE_PATH=$RSYNTAXTREE_HOME/gems BUNDLE_FROZEN=true \
    bundle install -j4 && \
    rm -rf $RSYNTAXTREE_HOME/gems/ruby/*/cache

ENV WORKSPACE=/monadic
WORKDIR $WORKSPACE

COPY Gemfile monadic.gemspec $WORKSPACE/
COPY config.ru $WORKSPACE/

ENV BUNDLER_WITHOUT="development test"
RUN bundle install -j4 && \
    rm -rf /usr/local/bundle/cache/*

# Stage 2: Runtime environment

FROM ruby:3.4.7-slim-bookworm
ARG PROJECT_TAG="monadic-chat"
LABEL project=$PROJECT_TAG

# Fingerprint for Gem dependencies to enable smart cache/refresh
ARG GEMS_FINGERPRINT=""
LABEL com.monadic.gems_hash=$GEMS_FINGERPRINT

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg lsb-release \
    postgresql-client \
    ffmpeg \
    # RSyntaxTree (Syntax Tree): its drawing libraries, and the fonts it
    # names for Latin, CJK and other scripts
    libgirepository-1.0-1 gir1.2-pango-1.0 gir1.2-rsvg-2.0 \
    fonts-noto-core fonts-noto-cjk fonts-dejavu-core \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://download.docker.com/linux/debian/gpg | \
    gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg

RUN echo "deb [arch=$(dpkg --print-architecture) \
         signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] \
         https://download.docker.com/linux/debian \
         $(lsb_release -cs) stable" | \
         tee /etc/apt/sources.list.d/docker.list > /dev/null

# Install the Docker client only. This container drives the host's daemon
# through the mounted /var/run/docker.sock (docker exec / ps / cp / compose),
# so it needs neither the daemon (docker-ce) nor containerd. Installing them
# only added a dependency pair that could fall out of step: containerd.io was
# pinned to 1.7 while docker-ce was not, and once docker-ce began requiring
# containerd 2.1.5 every uncached build of this image failed.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    docker-ce-cli docker-compose-plugin && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV WORKSPACE="/monadic"
WORKDIR $WORKSPACE

COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build $WORKSPACE $WORKSPACE

# The rsyntaxtree command: RSyntaxTree run in its own bundle
ENV RSYNTAXTREE_HOME=/opt/rsyntaxtree
COPY --from=build $RSYNTAXTREE_HOME $RSYNTAXTREE_HOME
RUN printf '%s\n' '#!/bin/sh' \
      "BUNDLE_GEMFILE=$RSYNTAXTREE_HOME/Gemfile BUNDLE_PATH=$RSYNTAXTREE_HOME/gems BUNDLE_FROZEN=true exec bundle exec rsyntaxtree \"\$@\"" \
      > /usr/local/bin/rsyntaxtree && chmod +x /usr/local/bin/rsyntaxtree

COPY apps/ $WORKSPACE/apps/
COPY lib/ $WORKSPACE/lib/
COPY public/ $WORKSPACE/public/

# Prebuilt public help database JSON dump, generated by `rake help:build`.
# Installation is opt-in through the Help data UI. COPY tracks dump content
# changes; runtime version checks use the installation's full SHA-256.
COPY help_data/ $WORKSPACE/help_data/

# The page in the container loads the JS bundle only. It is built on the host
# (`npm run build:js`, which monadic.sh runs before this build) and shipped
# prebuilt in the app's package; the image has no Node.js to build it here.
RUN test -f $WORKSPACE/public/js/monadic.bundle.min.js || { \
      echo "ERROR: public/js/monadic.bundle.min.js is missing. Run 'npm run build:js' and build again." >&2; \
      exit 1; }
COPY views/ $WORKSPACE/views/
RUN mkdir -p $WORKSPACE/internal_config

# create directories log/, public/, tmp/, and tmp/pids/

RUN mkdir -p log/ bin/

COPY scripts/ $WORKSPACE/scripts/
RUN find $WORKSPACE/scripts -type f \( -name "*.sh" -o -name "*.rb" \) -exec chmod +x {} \;
ENV PATH="$WORKSPACE/scripts:$WORKSPACE/scripts/utilities:$WORKSPACE/scripts/cli_tools:$WORKSPACE/scripts/generators:/usr/local/bundle/bin:${PATH}"

# Copy assets list for vendor assets
COPY bin/assets_list.sh $WORKSPACE/bin/assets_list.sh

COPY Dockerfile $WORKSPACE/Dockerfile

# Copy the entrypoint script into the container

COPY entrypoint.sh /usr/local/bin/entrypoint.sh

# Give execute permission to the script

RUN chmod +x /usr/local/bin/entrypoint.sh

# ~/monadic/config/rbsetup.sh comes in as a build secret: the script is not
# left in any layer, the image or the build context. RBSETUP_SHA (its hash)
# reruns this step when the script changes; builds without it skip it.
ARG RBSETUP_SHA=none
RUN --mount=type=secret,id=rbsetup,required=false \
    if [ -s /run/secrets/rbsetup ]; then bash /run/secrets/rbsetup; fi

# Download vendor assets for offline use
RUN /monadic/scripts/download_assets.sh

# Set the entrypoint to start the Falcon server
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
