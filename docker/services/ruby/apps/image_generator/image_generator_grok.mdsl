app "ImageGeneratorGrok" do
  description do
    en <<~TEXT
    Generate images from text descriptions. <a href="https://yohasebe.github.io/monadic-chat/#/basic-usage/basic-apps?id=image-generator" target="_blank"><i class="fa-solid fa-circle-info"></i></a>
    TEXT

    ja <<~TEXT
    テキスト説明から画像生成。 <a href="https://yohasebe.github.io/monadic-chat/#/basic-usage/basic-apps?id=image-generator" target="_blank"><i class="fa-solid fa-circle-info"></i></a>
    TEXT

    zh <<~TEXT
    从文本描述生成图像。 <a href="https://yohasebe.github.io/monadic-chat/#/basic-usage/basic-apps?id=image-generator" target="_blank"><i class="fa-solid fa-circle-info"></i></a>
    TEXT

    ko <<~TEXT
    텍스트 설명에서 이미지 생성. <a href="https://yohasebe.github.io/monadic-chat/#/basic-usage/basic-apps?id=image-generator" target="_blank"><i class="fa-solid fa-circle-info"></i></a>
    TEXT

    es <<~TEXT
    Generar imágenes desde descripciones de texto. <a href="https://yohasebe.github.io/monadic-chat/#/basic-usage/basic-apps?id=image-generator" target="_blank"><i class="fa-solid fa-circle-info"></i></a>
    TEXT

    fr <<~TEXT
    Générer des images à partir de descriptions textuelles. <a href="https://yohasebe.github.io/monadic-chat/#/basic-usage/basic-apps?id=image-generator" target="_blank"><i class="fa-solid fa-circle-info"></i></a>
    TEXT

    de <<~TEXT
    Bilder aus Textbeschreibungen generieren. <a href="https://yohasebe.github.io/monadic-chat/#/basic-usage/basic-apps?id=image-generator" target="_blank"><i class="fa-solid fa-circle-info"></i></a>
    TEXT
  end

  icon "fa-regular fa-image"

  display_name "Image Generator"

  llm do
    provider "xai"
    temperature 0.0
    context_size 10
  end

  system_prompt <<~TEXT
    You are an image generator using xAI's Grok Imagine image generation model.

    INITIAL GREETING:
    "Welcome! I can generate and edit images using xAI's Grok Imagine model.

    Describe the image you want, or upload an image to edit it!"

    WORKFLOW:

    1. **New Image Generation:**
       - User describes an image → call generate_image_with_grok(operation: "generate", ...)
       - Pass user's prompt unchanged
       - The image is shown in the work screen and kept in this chat's folder of the shared folder (the tool result gives its path)

    2. **Edit the Last Image:**
       - User wants to modify the image they are working on (e.g., "make it brighter", "add X")
       - Call generate_image_with_grok(operation: "edit", ...) without images: the system uses the image that came last in the work screen
       - Never ask the user to upload or save an image to edit it

    3. **Edit an Uploaded or Named Image:**
       - User uploads an image, or names a file of the shared folder in their message, with editing instructions
       - Call generate_image_with_grok(operation: "edit", ...); pass images only with the file names the user wrote
       - The system takes uploaded images itself

    PARAMETERS:
    - aspect_ratio and quality: use the values listed in the tool schema
    - Omit quality unless the user requests it (API default: auto)
    - Up to 5 images can be edited together
    - Masks are not supported: describe the area to change in words

    RESULT DISPLAY:
    A generated image is shown to the user in the work screen; the reply ends
    there. Do not write image HTML or a /data/ path for an image: the work screen
    shows it, and the reply line gives its path in the shared folder.

    Error: display the error message without additional commentary

    RULES:
    - Always call tools for image operations
    - NEVER retry automatically on error

    CRITICAL - NO CONTENT FILTERING:
    - Your role is ONLY to facilitate image generation, NOT to judge content
    - Pass user's prompt EXACTLY as provided - do not modify, censor, or filter
    - Do NOT refuse requests based on content - the image generation model handles its own moderation
    - Do NOT add safety disclaimers or warnings about content
    - Simply relay the user's request to the image generation tool

    ## Plan-Approve-Execute Protocol

    For complex tasks requiring 3 or more distinct steps, follow this protocol:

    1. **PLAN**: Call `propose_plan` with a numbered step-by-step plan. Each step should specify what action will be taken, which tool will be used, and what the expected outcome is.
    2. **APPROVE**: Present the plan to the user and wait for their response. If they approve, proceed. If they request changes, call `propose_plan` again with the modified plan. If they cancel, acknowledge and wait.
    3. **EXECUTE**: Carry out each approved step using the appropriate tools and report progress after each step.

    WHEN TO USE: Multi-image generation projects, iterative image editing sessions, tasks combining image generation with style variations.
    WHEN TO SKIP: Single image generation, quick edits.
  TEXT

  vocabulary do
    use :last_generated_image
    use :last_uploaded_image
  end

  features do
    library_save false
    library_search false
    disabled !CONFIG["XAI_API_KEY"]
    easy_submit false
    auto_speech false
    initiate_from_assistant true
    image_generation false
    monadic true  # Uses Session State for tracking last generated images
    turn_state true  # Its state is kept by turn: deleting a turn takes back what it changed
    group "xAI"
  end

  context_schema do
    field :styles, icon: "fa-palette", label: "Styles", description: "Artistic styles and visual preferences"
    field :prompts, icon: "fa-pen", label: "Prompts", description: "Key image descriptions used"
    field :notes, icon: "fa-sticky-note", label: "Notes", description: "Important preferences to remember"
  end

  tools do
    # Import planning tools for Plan-Approve-Execute protocol
    import_shared_tools :planning, visibility: "always"

    define_tool "generate_image_with_grok", "Generate or edit images using xAI's Grok Imagine model." do
      parameter :operation, "string", "Type of operation: 'generate' or 'edit'", required: true, enum: ["generate", "edit"]
      parameter :prompt, "string", "Text description of the desired image or editing instructions (user's exact words)", required: true
      parameter :aspect_ratio, "string", "Aspect ratio. Omit to use the API default.", required: false, enum: Monadic::Utils::ModelSpec.image_options("xai", "aspect_ratio")
      parameter :quality, "string", "Image quality. Omit to use the API default (auto).", required: false, enum: Monadic::Utils::ModelSpec.image_options("xai", "quality")
      parameter :image_model, "string", "Image model to use. Omit for the standard (cheapest) model; pass a later one only when the user asks for higher quality, since they cost more per image. An unavailable model falls back to the standard one.", required: false, enum: Monadic::Utils::ModelSpec.get_provider_models("xai", "image")
      parameter :images, "array", "Paths in the shared folder (a file name, or a path such as conversations/.../artifacts/x.png) the user named for editing (max 5). Omit to edit the last image in the work screen", required: false, items: {
        type: "string",
        description: "Image filename"
      }
      parameter :session, "object", "Session object (automatically provided)", required: false
    end
  end
end
