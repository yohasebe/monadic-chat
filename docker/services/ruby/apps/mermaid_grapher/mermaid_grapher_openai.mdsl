app "MermaidGrapherOpenAI" do
  description do
    en <<~TEXT
    Create diagrams using Mermaid markdown syntax.
    TEXT
    
    ja <<~TEXT
    Mermaidマークダウン構文での図表作成。
    TEXT
    
    zh <<~TEXT
    使用Mermaid markdown语法创建图表。
    TEXT
    
    ko <<~TEXT
    Mermaid 마크다운 구문으로 다이어그램 생성.
    TEXT
    
    es <<~TEXT
    Crear diagramas usando sintaxis Mermaid markdown.
    TEXT
    
    fr <<~TEXT
    Créer des diagrammes avec la syntaxe Mermaid markdown.
    TEXT
    
    de <<~TEXT
    Diagramme mit Mermaid-Markdown-Syntax erstellen.
    TEXT
  end
  icon MermaidGrapher::ICON
  display_name MermaidGrapher::DISPLAY_NAME

  system_prompt MermaidGrapher::SYSTEM_PROMPT
  
  llm do
    provider "openai"
    reasoning_effort "none"
    temperature 0.0
  end
  
  features do
    library_save false
    library_search false
    disabled !CONFIG["OPENAI_API_KEY"]
    mermaid true
    easy_submit false
    auto_speech false
    initiate_from_assistant false
    autonomy "high"
  end
  
  tools do
    # Import unified web search tools (conditional - native or Tavily)
    import_shared_tools :web_search_tools, visibility: "conditional"

    # Import planning tools for Plan-Approve-Execute protocol
    import_shared_tools :planning, visibility: "always"

    # Import verification tools for Self-Verification protocol
    import_shared_tools :verification, visibility: "always"

    define_tool "validate_mermaid_syntax", "Validate Mermaid diagram syntax without rendering" do
      parameter :code, "string", "Mermaid diagram code to validate", required: true
    end

    define_tool "preview_mermaid", "Validate and render Mermaid diagram, capturing a screenshot for verification" do
      parameter :code, "string", "Mermaid diagram code to validate and preview", required: true
    end

    define_tool "analyze_mermaid_error", "Analyze Mermaid diagram error and provide fix suggestions" do
      parameter :code, "string", "Mermaid diagram code that caused the error", required: true
      parameter :error, "string", "Error message to analyze", required: true
    end

    define_tool "fetch_mermaid_docs", "Get documentation URL for a Mermaid diagram type" do
      parameter :diagram_type, "string", "Mermaid diagram type (flowchart, sequence, class, state, er, gantt, pie, sankey, mindmap)", required: true
    end
  end
end
