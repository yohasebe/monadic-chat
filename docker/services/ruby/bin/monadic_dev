#!/usr/bin/env ruby

# frozen_string_literal: false

require "optimist"
require "open3"
require_relative "../lib/monadic/version"

# Change current directory to the parent directory of the directory containing this file
Dir.chdir(File.expand_path(File.join(__dir__, "..")))

DEFAULT_PORT = 4567
PID_FILE = __dir__ + "/falcon.pid"

DATA_DIR = File.expand_path(File.join(ENV["HOME"], "monadic", "data"))
LOG_DIR = File.expand_path(File.join(ENV["HOME"], "monadic", "log"))

# Find docker command (system() doesn't use login shell PATH)
DOCKER_CMD = `which docker 2>/dev/null`.strip
DOCKER_CMD = "/usr/local/bin/docker" if DOCKER_CMD.empty?

# Verify docker command exists
unless File.executable?(DOCKER_CMD)
  STDERR.puts "ERROR: Docker command not found at: #{DOCKER_CMD}"
  STDERR.puts "Please ensure Docker is installed and in PATH"
  exit 1
end

STDERR.puts "[DEBUG] Using docker command: #{DOCKER_CMD}" if ENV['EXTRA_LOGGING']
STDERR.puts "[DEBUG] DOCKER_CONTEXT: #{ENV['DOCKER_CONTEXT']}" if ENV['EXTRA_LOGGING']

Dir.mkdir(DATA_DIR) unless Dir.exist?(DATA_DIR)
Dir.mkdir(LOG_DIR) unless Dir.exist?(LOG_DIR)

File.open(File.join(LOG_DIR, "command.log"), "w") {}
File.open(File.join(LOG_DIR, "jupyter.log"), "w") {}

# Helper methods for OS detection
def is_mac?
  RUBY_PLATFORM.include?('darwin')
end

def is_linux?
  RUBY_PLATFORM.include?('linux')
end

# Select appropriate Selenium image based on architecture
selenium_image = "selenium/standalone-chromium:4.40.0-20260202"

# Set environment variables
ENV["SELENIUM_IMAGE"] = selenium_image
ENV["MONADIC_VERSION"] = Monadic::VERSION.to_s
ENV["HOST_OS"] = `uname -s`.chomp

# Load UI_LANGUAGE from env file if exists
env_file_path = File.expand_path(File.join(ENV["HOME"], "monadic", "config", "env"))
if File.exist?(env_file_path)
  File.readlines(env_file_path).each do |line|
    if line.start_with?("UI_LANGUAGE=")
      ENV["UI_LANGUAGE"] = line.split("=", 2)[1].strip
      break
    end
  end
end

# Define required containers for the application (support legacy names)
# Each entry is an array of possible names; first existing one will be used.
REQUIRED_CONTAINER_ALIASES = [
  ["monadic-chat-python-container", "python-container"],
  ["monadic-chat-qdrant-container", "qdrant-container"],
  ["monadic-chat-embeddings-container", "embeddings-container"],
  # Selenium should be up for browser automation by default; keep legacy name for compatibility
  ["monadic-chat-selenium-container", "selenium-container"]
]

# Parse command line options
opts = Optimist.options do
  version Monadic::VERSION.to_s
  banner "Usage: monadic [start|stop|restart|export|input] [options]"
  opt :daemonize, "Enable or disable daemon mode", default: false
  opt :log, "Enable or disable logging mode", default: false
  opt :port, "Specify the port number", type: :integer, default: DEFAULT_PORT
end

DOCKER_HOME = File.expand_path(File.join(__dir__, "..", ".."))

MONADIC_SH = File.expand_path(File.join(DOCKER_HOME, "..", "monadic.sh"))

# The engine the Docker CLI chooses, as monadic.sh resolves it for the app
# (the same rule): "origin", "context", "endpoint", "desktop", "answers",
# "engine", "refused".
def runtime_info
  out, = Open3.capture2(MONADIC_SH, "runtime")
  out.lines.each_with_object({}) do |line, info|
    key, value = line.chomp.split("=", 2)
    info[key] = value.to_s if key && value
  end
rescue SystemCallError
  {}
end

# [ok, what to say]. When the engine answers, this process keeps to it
# (DOCKER_HOST) for the rest of the run.
def ensure_docker_ready
  info = runtime_info
  return [false, "Docker cannot be used: #{info['refused']}"] unless info["refused"].to_s.empty?
  return [false, "The Docker engine (#{info['context'].to_s.empty? ? 'DOCKER_HOST' : info['context']}) is not running"] unless info["answers"] == "1"

  ENV["DOCKER_HOST"] = info["endpoint"]
  ENV.delete("DOCKER_CONTEXT")
  [true, info["engine"]]
end

# Starts Docker Desktop, on macOS, when the engine chosen is Docker
# Desktop's; another engine is started by its owner.
def try_start_docker
  return false unless is_mac? && runtime_info["desktop"] == "1"

  clean_env = ENV.to_h.reject { |k, _| k.start_with?('BUNDLE', 'RUBY') }
  clean_env['PATH'] = '/usr/bin:/bin:/usr/sbin:/sbin'
  pid = Process.spawn(clean_env, '/usr/bin/open', '-a', 'Docker', unsetenv_others: true, [:out, :err] => '/dev/null')
  Process.detach(pid)
  true
end

# Helper methods for container management
def container_exists?(container_name)
  system("#{DOCKER_CMD} container inspect #{container_name} > /dev/null 2>&1")
end

def container_running?(container_name)
  return false unless container_exists?(container_name)
  `#{DOCKER_CMD} container inspect #{container_name} --format '{{.State.Status}}'`.chomp == "running"
end

def start_server(opts)
  docker_ok = false
  docker_output = ""
  started = false

  # The Ruby container (if running) is stopped below in STEP 2, after the Docker
  # daemon readiness check — NOT by monadic_server.sh, which only exports
  # MONADIC_DEV and calls this. In dev we run Ruby on the host via Falcon, so the
  # container must not also bind the port. (The MONADIC_DEV recreate in STEP 3a
  # can bring it back up; STEP 3c re-stops it before Falcon starts.)

  # Check if Docker daemon is running, with auto-start capability
  if ENV["SKIP_DOCKER_CHECK"]
    puts "⏭️  Skipping Docker daemon check (SKIP_DOCKER_CHECK is set)"
    docker_ok = true
  else
    90.times do
      docker_ok, docker_output = ensure_docker_ready
      break if docker_ok
      break if docker_output.start_with?("Docker cannot be used")

      started ||= try_start_docker
      sleep 1
    end
  end

  unless docker_ok
    STDERR.puts "[DEBUG] Docker info full output:\n#{docker_output}" if ENV['EXTRA_LOGGING']
    puts "\n" + "=" * 70
    puts "⚠️  #{docker_output}"
    puts "=" * 70
    puts "\nStart Docker Desktop, or the Docker-compatible engine the Docker CLI points to"
    puts "(docker context show), then run: rake server:debug\n"
    puts "=" * 70 + "\n"
    exit 1
  else
    puts "✅ Docker daemon is responding"
  end

  # Stop Ruby container if running (we're running Ruby locally, not in Docker)
  ruby_container_names = ["monadic-chat-ruby-container", "ruby-container"]
  ruby_container_names.each do |container_name|
    if container_running?(container_name)
      puts "🛑 Stopping Ruby container (#{container_name}) for local development..."
      system("#{DOCKER_CMD} container stop #{container_name} > /dev/null 2>&1")
      # Wait for container to stop
      15.times do
        break unless container_running?(container_name)
        sleep 0.5
      end
      puts "✅ Ruby container stopped"
      break
    end
  end

  # STEP 3a: When MONADIC_DEV=true, host-side scripts and specs need
  # qdrant/embeddings to publish their ports. Detect when an existing
  # container was created without the dev compose overlay (no published
  # ports) and trigger `monadic.sh start` to recreate via compose, which
  # picks up compose.dev.yml. Without this, the user has to manually run
  # `docker rm -f ...` + `MONADIC_DEV=true ./docker/monadic.sh start`.
  if ENV['MONADIC_DEV'] == 'true'
    needs_recreate = false
    %w[monadic-chat-qdrant-container monadic-chat-embeddings-container].each do |cname|
      next unless container_exists?(cname)
      ports = `#{DOCKER_CMD} port #{cname} 2>/dev/null`.to_s.strip
      if ports.empty?
        puts "⚠️  #{cname} has no host port mapping; dev overlay needs to recreate it"
        needs_recreate = true
        break
      end
    end
    if needs_recreate
      monadic_sh = File.expand_path('../../../monadic.sh', __dir__)
      if File.executable?(monadic_sh)
        puts "🔄 Recreating support containers via #{monadic_sh} start (MONADIC_DEV=true)"
        system({'MONADIC_DEV' => 'true'}, monadic_sh, 'start')
      else
        puts "ℹ️  monadic.sh not found at #{monadic_sh}; skipping dev recreate"
      end
    end
  end

  # STEP 3b: Start required support containers (NOT Ruby container)
  REQUIRED_CONTAINER_ALIASES.each do |aliases|
    name = aliases.find { |n| container_exists?(n) }
    next unless name
    unless container_running?(name)
      puts "Starting #{name}..."
      system("#{DOCKER_CMD} container start #{name}")
      # Wait for container to start
      30.times do  # Try for 15 seconds (30 * 0.5)
        break if container_running?(name)
        sleep 0.5
      end
    end
  end

  # STEP 3c: The MONADIC_DEV recreate in STEP 3a runs `monadic.sh start`, which
  # brings the WHOLE compose stack up — including the Ruby container STEP 2 just
  # stopped. If it comes back, its published 127.0.0.1:PORT shadows the host
  # Falcon for localhost connections (macOS prefers the more specific bind), so
  # the browser silently hits stale baked-in container code instead of local
  # source. Re-stop it here so local Falcon is unambiguously the dev server.
  ruby_container_names.each do |container_name|
    next unless container_running?(container_name)
    puts "🛑 Re-stopping Ruby container (#{container_name}) resurrected by dev recreate..."
    system("#{DOCKER_CMD} container stop #{container_name} > /dev/null 2>&1")
    15.times do
      break unless container_running?(container_name)
      sleep 0.5
    end
  end

  # Check if server is already running locally
  if File.exist?(PID_FILE)
    begin
      pid = File.read(PID_FILE).to_i
      if pid > 0
        Process.kill(0, pid)
        puts "Server is already running"
        return
      end
    rescue Errno::ESRCH, Errno::EPERM
      # Remove PID file if process doesn't exist or we don't have permission
      File.delete(PID_FILE)
    end
  end

  # macOS fork safety for Falcon
  ENV["OBJC_DISABLE_INITIALIZE_FORK_SAFETY"] = "YES"

  # Start local Falcon server
  # This machine only: nothing on the server checks who connects
  cmd = "bundle exec falcon serve -b http://127.0.0.1:#{opts[:port] || DEFAULT_PORT} -c config.ru --count 1"

  if opts[:daemonize]
    # Daemon mode: run in background
    puts "Starting Monadic Chat in daemon mode..."
    pid = spawn(cmd, out: File.join(LOG_DIR, "server.log"), err: File.join(LOG_DIR, "server.log"))
    Process.detach(pid)
    File.write(PID_FILE, pid.to_s)
    puts "Server started on port #{opts[:port] || DEFAULT_PORT}"
    puts "System available at: http://localhost:#{opts[:port] || DEFAULT_PORT}"
  else
    # Debug mode: run in foreground with output
    puts "Starting Monadic Chat in debug mode..."
    puts "Access the application at: http://localhost:#{opts[:port] || DEFAULT_PORT}"
    puts "Press Ctrl+C to stop\n\n"
    exec(cmd)
  end
end

def stop_server
  # Stop the main server process (Falcon)
  begin
    # Find the server by name AND by the port it holds. Name matching alone is
    # not enough: depending on how it was launched, the listener can run as a
    # bare `ruby` process whose command line lacks "falcon serve", so a stale
    # server survives `restart` and the next start can't bind the port — which
    # silently serves old code/MDSL. Killing whoever holds the port covers that.
    port = DEFAULT_PORT
    name_pids = `pgrep -f "falcon serve"`.strip.split("\n")
    port_pids = `lsof -ti tcp:#{port} -sTCP:LISTEN 2>/dev/null`.strip.split("\n")
    server_pids = (name_pids + port_pids).map(&:strip).reject(&:empty?).uniq
    if server_pids.any?
      server_pids.each do |pid|
        begin
          Process.kill(9, pid.to_i)
          puts "Killed server process #{pid}"
        rescue Errno::ESRCH
          # Process already stopped
        end
      end
      puts "Server stopped; Stopping docker containers"
    else
      puts "Server not running"
    end
  rescue StandardError => e
    puts "Error stopping server: #{e.message}"
  end

  # Stop all required containers (resolve each alias group to the existing name)
  REQUIRED_CONTAINER_ALIASES.each do |aliases|
    container_name = aliases.find { |n| container_exists?(n) }
    next unless container_name

    system("#{DOCKER_CMD} container stop #{container_name}")

    # Wait for container to stop
    30.times do  # Try for 15 seconds (30 * 0.5)
      break unless container_running?(container_name)
      sleep 0.5
    end
  end
end

# Restart the server
def restart_server(opts)
  stop_server
  sleep 2  # Wait for processes to fully stop
  start_server(opts)
end

def print_status
  # Check main server status (Falcon)
  falcon_pids = `pgrep -f "falcon serve"`.strip.split("\n")
  server_status = falcon_pids.any? ? "running (PIDs: #{falcon_pids.join(', ')})" : "not running"
  puts "Main server is #{server_status}"

  # Print status of required containers (resolve each alias group to the existing name)
  puts "\nContainer Status:"
  REQUIRED_CONTAINER_ALIASES.each do |aliases|
    container_name = aliases.find { |n| container_exists?(n) }
    if container_name
      status = container_running?(container_name) ? "running" : "stopped"
      puts "#{container_name}: #{status}"
    else
      puts "#{aliases.first}: does not exist"
    end
  end
end

# Parse and execute subcommand
subcommand = ARGV.shift

case subcommand
when "start"
  start_server(opts)
when "stop"
  stop_server
when "restart"
  restart_server(opts)
when "status"
  print_status
else
  Optimist.die "Unknown subcommand. Use \"start\", \"stop\", \"restart\", or \"status\""
end
