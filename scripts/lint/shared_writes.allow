docker/services/ruby/lib/monadic/utils/environment.rb | File.open(file, 'w') | log | log rotation
docker/services/ruby/lib/monadic/utils/degradation_notifier.rb | File.open(path, 'a') | log | degradation log
docker/services/ruby/lib/monadic/adapters/jupyter_helper.rb | File.open(JUPYTER_LOG_FILE | log | Jupyter log
docker/services/ruby/lib/monadic/help/installation.rb | FileUtils.mkdir_p(@directory) | state | help install coordination (state folder)
docker/services/ruby/lib/monadic/help/installation.rb | File.open(File.join(@directory, "#{name}.lock"), mode | state | help install locks (state folder)
docker/services/ruby/lib/monadic/help/installation.rb | Tempfile.create(['progress-' | state | help install journal (state folder)
docker/services/ruby/lib/monadic/help/installation.rb | File.rename(file.path | state | help install journal (state folder)
docker/services/ruby/lib/monadic/routes/pdf_routes.rb | Tempfile.new("temp_pdf") | system-temp | the system's temporary folder
docker/services/ruby/apps/drawio_grapher/drawio_grapher_tools.rb | FileUtils.mkdir_p(data_dir) | shared-root | the shared folder itself
docker/services/ruby/apps/auto_forge/auto_forge.rb | File.open(local, 'wb') | system-temp | patch work folder (Dir.mktmpdir)
docker/services/ruby/apps/auto_forge/auto_forge.rb | File.write(diff, patch_text) | system-temp | patch work folder (Dir.mktmpdir)
docker/services/ruby/apps/auto_forge/utils/directory_operations.rb | FileUtils.rm_rf(@test_dir) | test-only | the file's own self-test (Dir.mktmpdir)
docker/services/ruby/apps/auto_forge/utils/directory_operations.rb | FileUtils.mkdir_p(File.join(@test_dir | test-only | the file's own self-test (Dir.mktmpdir)
docker/services/ruby/apps/auto_forge/utils/directory_operations.rb | File.write(File.join(@test_dir | test-only | the file's own self-test (Dir.mktmpdir)
docker/services/ruby/scripts/utilities/process_documentation.rb | FileUtils.mkdir_p(HELP_DATA_DIR) | build-time | builds the help dump in the source tree
