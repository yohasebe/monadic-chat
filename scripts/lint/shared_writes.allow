# Raw file writes the shared-folder lint lets through. Everything the Ruby
# server (lib/, apps/) and its scripts (scripts/) write in the shared folder
# goes through Monadic::Utils::SharedPathGuard; a raw write is allowed only
# where it cannot be in the shared folder, or is at its root (which the other
# program cannot replace).
#
# One entry per line: path | text the line contains | where it writes | why
# where: state, log, config, system-temp, shared-root, build-time, test-only
docker/services/ruby/lib/monadic.rb | FileUtils.mkdir_p(File.dirname(legacy_volume_marker)) | log | notice marker in the log folder
docker/services/ruby/lib/monadic.rb | File.write(legacy_volume_marker | log | notice marker in the log folder
docker/services/ruby/lib/monadic/app.rb | File.open(COMMAND_LOG_FILE | log | command log
docker/services/ruby/lib/monadic/shell.rb | File.open(log_path | log | command log
docker/services/ruby/lib/monadic/workspace/artifacts.rb | Dir.mkdir(root, 0o700) | state | folder of kept artifacts (state folder)
docker/services/ruby/lib/monadic/workspace/artifacts.rb | Dir.mkdir(dir, 0o700) | state | one kept artifact's folder, made new (state folder)
docker/services/ruby/lib/monadic/workspace/artifacts.rb | FileUtils.rm_rf(dir) | state | removes the artifact folder this call made when its record cannot be made (state folder)
docker/services/ruby/lib/monadic/workspace/ledger.rb | File.open(path, File::WRONLY | state | ledger (state folder)
docker/services/ruby/lib/monadic/workspace/ledger.rb | File.unlink(path) | state | ledger (state folder)
docker/services/ruby/lib/monadic/workspace/ledger.rb | File.rename(from, to) | state | ledger (state folder)
docker/services/ruby/lib/monadic/workspace/ledger.rb | FileUtils.mkdir_p(File.dirname(path), mode: 0o700) | state | ledger (state folder)
docker/services/ruby/lib/monadic/workspace/ledger.rb | File.open(@lock_path | state | ledger lock (state folder)
docker/services/ruby/lib/monadic/workspace/ledger.rb | File.unlink(tmp) | state | ledger (state folder)
docker/services/ruby/lib/monadic/workspace/server_owner.rb | FileUtils.mkdir_p(@dir | state | server mark (state folder)
docker/services/ruby/lib/monadic/workspace/server_owner.rb | FileUtils.rm_rf(path_of(target)) | state | server mark (state folder)
docker/services/ruby/lib/monadic/workspace/server_owner.rb | Dir.mkdir(draft | state | server mark (state folder)
docker/services/ruby/lib/monadic/workspace/server_owner.rb | File.open(File.join(path_of(@generation), STOPPED) | state | server mark (state folder)
docker/services/ruby/lib/monadic/workspace/server_owner.rb | File.open(File.join(draft, FILE) | state | server mark draft, made new (O_EXCL) (state folder)
docker/services/ruby/lib/monadic/workspace/server_owner.rb | File.rename(draft | state | server mark (state folder)
docker/services/ruby/lib/monadic/workspace/server_owner.rb | FileUtils.rm_rf(draft) | state | server mark (state folder)
docker/services/ruby/lib/monadic/workspace/server_owner.rb | FileUtils.rm_rf(path_of(n)) | state | server mark (state folder)
docker/services/ruby/lib/monadic/workspace/shared_folder.rb | File.open(temp, File::WRONLY | shared-root | id file: made new (O_EXCL) at the root
docker/services/ruby/lib/monadic/workspace/shared_folder.rb | File.link(temp, path) | shared-root | id file: a hard link fails rather than replace
docker/services/ruby/lib/monadic/workspace/shared_folder.rb | File.unlink(temp) | shared-root | id file: its own temporary name at the root
docker/services/ruby/lib/monadic/agents/ai_user_agent.rb | FileUtils.mkdir_p(log_dir) | log | log folder
docker/services/ruby/lib/monadic/agents/ai_user_agent.rb | File.open(File.join(log_dir, 'ai_user_debug.log'), 'a') | log | debug log in the log folder
docker/services/ruby/lib/monadic/agents/audio_analysis_agent.rb | Tempfile.new(["music_analyst" | system-temp | the system's temporary folder
docker/services/ruby/lib/monadic/utils/tool_image_utils.rb | FileUtils.mkdir_p(dir) unless Dir.exist?(dir) | shared-root | the shared folder itself
docker/services/ruby/lib/monadic/utils/extra_logger.rb | File.open(log_file | log | extra log
docker/services/ruby/lib/monadic/utils/setup.rb | FileUtils.mkdir_p(File.dirname(ENV_PATH)) | config | config folder
docker/services/ruby/lib/monadic/utils/setup.rb | FileUtils.touch(ENV_PATH) | config | config env file
docker/services/ruby/lib/monadic/utils/setup.rb | FileUtils.mkdir_p(SCRIPTS_PATH) | shared-root | a folder at the root, skipped when anything (a link too) is there
docker/services/ruby/lib/monadic/utils/setup.rb | FileUtils.mkdir_p(APPS_PATH) | shared-root | a folder at the root, skipped when anything (a link too) is there
docker/services/ruby/lib/monadic/utils/setup.rb | FileUtils.mkdir_p(HELPERS_PATH) | shared-root | a folder at the root, skipped when anything (a link too) is there
